# Copy to .env and adjust for local development.
# Never commit .env — it is listed in .gitignore.

# ---- PostgreSQL ----
POSTGRES_DB=messaging
POSTGRES_USER=messaging
POSTGRES_PASSWORD=messaging

# ---- IBM MQ (developer image) ----
# LICENSE=accept is set in docker-compose.yml; you accept the IBM MQ Advanced
# for Developers license by running the stack. See:
# https://www.ibm.com/support/pages/ibm-mq-advanced-developers
MQ_QMGR_NAME=QM1
MQ_APP_PASSWORD=passw0rd
MQ_ADMIN_PASSWORD=passw0rd

# ---- Backend (Spring Boot) ----
# Kept here for reference — the backend reads these when run locally.
DB_URL=jdbc:postgresql://localhost:5432/messaging
DB_USERNAME=messaging
DB_PASSWORD=messaging

MQ_CONN_NAME=localhost(1414)
MQ_CHANNEL=DEV.APP.SVRCONN
MQ_APP_USER=app

APP_MQ_QUEUE=DEV.QUEUE.1
APP_MQ_BACKOUT_QUEUE=DEV.QUEUE.BACKOUT
APP_MQ_BACKOUT_THRESHOLD=3
APP_MQ_CONCURRENCY=5-10
